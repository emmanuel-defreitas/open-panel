{
  "name": "open-panel-element",
  "version": "0.1.0",
  "license": "MIT",
  "description": "<open-panel-workspace>: Open-Panel as a custom element for any framework or none.",
  "type": "module",
  "author": "Emmanuel De Freitas",
  "homepage": "https://github.com/emmanuel-defreitas/open-panel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmanuel-defreitas/open-panel.git",
    "directory": "packages/element"
  },
  "keywords": [
    "web-components",
    "custom-element",
    "docking",
    "layout",
    "tabs",
    "panels",
    "workspace"
  ],
  "sideEffects": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standalone": "./dist/open-panel-element.standalone.js",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE*.md",
    "README.md"
  ],
  "peerDependencies": {
    "open-panel-core": "^0.1.0"
  },
  "scripts": {
    "build": "tsup && node ../core/scripts/build-css.mjs dist/style.css",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "open-panel-core": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "private": true
}
