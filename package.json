{
  "name": "open-panel",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "demo"
    ],
    "catalog": {
      "@types/node": "^24.19.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^5.2.0",
      "jsdom": "^26.1.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tsup": "^8.5.1",
      "typescript": "~5.9.3",
      "vite": "^7.3.7",
      "vitest": "^3.2.7"
    }
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "dev": "bun run --filter open-panel-demo dev",
    "typecheck": "tsc --noEmit && bun run --filter './packages/*' --filter './demo/*' typecheck",
    "test": "vitest run",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "jsdom": "catalog:",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
